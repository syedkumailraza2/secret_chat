# Copy to `.env` and fill in — keep this template in place, it is the
# committed reference. `.env` itself is gitignored and must never be shared.

# Required for AI recipe and image generation. Without it the backend serves
# nothing from the AI path and the create flow reports it is unavailable.
OPENAI_API_KEY=sk-your-key-here

# Model IDs. Changing these needs no code change.
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2

# Sampling temperature for recipe text.
OPENAI_TEMPERATURE=0.7

# How many recipes a single generate call returns.
RECIPES_PER_REQUEST=3

# Force generation off even when a key is present (useful for demos).
MOCK_AI=false

# Where generated recipe photos are written. Relative paths resolve
# against the backend directory.
MEDIA_DIR=media

# MongoDB. Point this at a local server, a container, or an Atlas cluster.
# Atlas looks like: mongodb+srv://user:pass@cluster.xxxxx.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=nutricook

# Signs access tokens. Leave it unset in development and one is generated per
# process — which means every restart invalidates outstanding tokens, so set
# it explicitly anywhere that matters. Any long random string will do.
JWT_SECRET=

# Access tokens are short-lived because they cannot be revoked; refresh
# tokens are long-lived but stored server-side and rotated on every use.
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# Unlocks the hidden secret chat. Leave it empty and the feature is off — the
# unlock endpoint then answers 404. Anyone who knows the code can join.
SECRET_CHAT_CODE=

PORT=8010
